# ---------- ClickUp ----------
# Personal API token: ClickUp > Settings > Apps > API Token (starts with pk_)
CLICKUP_API_TOKEN=
# Workspace (team) id: the number in https://app.clickup.com/<TEAM_ID>/...
CLICKUP_TEAM_ID=
# Optional: your ClickUp user id (auto-detected from the token when empty)
CLICKUP_USER_ID=
# Only pick tasks in these statuses (comma separated, empty = every open status)
PICK_STATUSES=to do
# Status set while the agent works on a task (empty = don't change)
IN_PROGRESS_STATUS=in progress
# Status set when the task is finished and pushed
DONE_STATUS=done
# Status set on tasks without details / judged too vague, after the auto comment (empty = leave as is)
NO_DETAILS_STATUS=done
# A description shorter than this (characters) counts as "no details"
MIN_DESCRIPTION_LENGTH=20

# ---------- Repositories ----------
# name|path|test command ; separated. Use a DEDICATED clean clone per repo (the
# service resets it to <remote>/<branch> when a task fails).
# A task is routed to the repo whose name matches one of its ClickUp tags, else DEFAULT_REPO.
REPOS=front|/path/to/automation/frontend|npm test;back|/path/to/automation/backend|npm test
DEFAULT_REPO=front
GIT_REMOTE=origin
# Each task is developed on <prefix><task id>-<slug>, pushed, and a GitLab merge
# request into GIT_TARGET_BRANCH is opened automatically (review + merge by a human)
GIT_TARGET_BRANCH=dev
GIT_BRANCH_PREFIX=cu/
# Optional commit identity (falls back to the repo's git config)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=

# ---------- Models (the agent runs in Claude Code, on any of these providers) ----------
# USA:   anthropic (default) | openrouter (OpenAI GPT, Google Gemini, xAI Grok, Meta Llama, ...)
# China: deepseek | qwen | kimi | glm | minimax
# Other: custom (any Anthropic-compatible endpoint, e.g. a LiteLLM proxy for OpenAI / Gemini direct)
LLM_PROVIDER=anthropic
# Developer model (empty = the provider's default, see README). For anthropic: e.g. opus, sonnet
LLM_MODEL=
# Read-only decision step (develop / needs details / skip + repo). Empty provider = LLM_PROVIDER;
# empty model = LLM_MODEL on the same provider, else that provider's default
DECISION_PROVIDER=
DECISION_MODEL=

# anthropic: leave empty to use your logged-in Claude Code session, or set an API key
ANTHROPIC_API_KEY=
# openrouter: openrouter.ai/keys  (models: openai/gpt-5, google/gemini-2.5-pro, x-ai/grok-4, qwen/qwen3-coder, ...)
OPENROUTER_API_KEY=
# deepseek: platform.deepseek.com
DEEPSEEK_API_KEY=
# qwen: Alibaba Model Studio / DashScope (mainland: DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic)
DASHSCOPE_API_KEY=
# kimi: platform.moonshot.ai (mainland: MOONSHOT_BASE_URL=https://api.moonshot.cn/anthropic)
MOONSHOT_API_KEY=
# glm: z.ai (mainland: ZAI_BASE_URL=https://open.bigmodel.cn/api/anthropic)
ZAI_API_KEY=
# minimax: platform.minimax.io (mainland: MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic)
MINIMAX_API_KEY=
# custom: any Anthropic-compatible endpoint (set LLM_MODEL too)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
# Every preset endpoint can be overridden with <PROVIDER KEY NAME>_BASE_URL, e.g. DEEPSEEK_BASE_URL

# ---------- Claude Code (the agent runtime) ----------
CLAUDE_BIN=claude
CLAUDE_DECISION_TIMEOUT_MINUTES=10
# Tools the developer agent may use (comma separated). Anything else is denied.
# Empty = default: Read, Edit, Write, Glob, Grep + npm test/lint/typecheck, npx tsc/vitest/jest, git status/diff/log
CLAUDE_ALLOWED_TOOLS=
CLAUDE_TIMEOUT_MINUTES=45
TEST_TIMEOUT_MINUTES=15

# ---------- Jev final decision (optional, TypeSafe AI) ----------
# Claude triage reformulates the task; Jev (jev-latest) takes the final develop / needs_details / skip
# decision with a calibrated confidence. Empty key = the triage decision is final. https://docs.typesafe.ai
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Below this confidence the task goes back to a human (needs_details)
JEV_MIN_CONFIDENCE=0.7

# ---------- WhatsApp notifications (optional) ----------
# Provider: twilio | meta | callmebot  (empty = notifications off)
WHATSAPP_PROVIDER=
# The assigned developer's number (only they are notified), international format, e.g. +2126XXXXXXXX
WHATSAPP_TO=
# Outcomes to notify: done,error,blocked,no-changes,needs-details,no-details,skipped
WHATSAPP_EVENTS=done,error,blocked,no-changes
# twilio: console.twilio.com (FROM = your WhatsApp-enabled Twilio number or sandbox number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# meta: WhatsApp Cloud API (developers.facebook.com): access token + phone number id
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
# callmebot: free personal API, get the key by messaging their bot (callmebot.com)
CALLMEBOT_API_KEY=

# ---------- Service ----------
POLL_INTERVAL_SECONDS=300
# Failed attempts per task before the service gives up and comments the error
MAX_ATTEMPTS=2
